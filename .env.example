APP_NAME=LaravelDrive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# dev/test default; production uses MySQL (see README)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_drive
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- seed admin (UsersTableSeeder) -------------------------------------------
ADMIN_NAME=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# --- cloud storage disks (optional) ------------------------------------------
FILESYSTEM_CLOUD=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# UPLOADS_FTP_HOST=
# UPLOADS_FTP_USER=
# UPLOADS_FTP_PASSWORD=
# UPLOADS_DIGITALOCEAN_ACCESS_KEY=
# UPLOADS_DIGITALOCEAN_SECRET_KEY=
# UPLOADS_DIGITALOCEAN_REGION=
# UPLOADS_DIGITALOCEAN_BUCKET=
# UPLOADS_DIGITALOCEAN_ENDPOINT=
# DROPBOX_TOKEN=

# --- social login providers (empty = disabled) -------------------------------
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/login/handle/facebook/"
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI="${APP_URL}/login/handle/twitter/"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/login/handle/google/"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI="${APP_URL}/login/handle/github/"
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI="${APP_URL}/login/handle/youtube/"
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI="${APP_URL}/login/handle/twitch/"
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_REDIRECT_URI="${APP_URL}/login/handle/instagram/"

# --- Laravel Reverb (websockets) ---------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=/app

# --- chunk upload ------------------------------------------------------------
CHUNK_UPLOAD_LOGGING_ENABLED=false

# --- billing (D18): storage plans + Midtrans QRIS ------------------------------
# Enforcement stays OFF until the owner flips the switch (all users keep
# historical unlimited storage while false).
BILLING_ENABLED=false
# FREE_PLAN_MAX_STORAGE=2147483648
# VIP_PLAN_MAX_STORAGE=53687091200
# VIP_PLAN_PRICE=0
# VIP_PLAN_CURRENCY=IDR
# VIP_PLAN_DURATION_DAYS=30
BILLING_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
